# Noms des variables du projet, avec des valeurs FACTICES. Jamais de vraie valeur ici.
# Le jeu lui-même n'a besoin d'aucun secret (site statique).
#
# En local  : kit secrets add NOM -g      (jetons partagés entre projets)
#             kit secrets check
# En cloud  : variables de l'environnement cloud (claude.ai/code), lues par `kit api`.

# --- Build (argument Docker, facultatif) ---
GODOT_VERSION=4.7.2

# --- Outillage de déploiement (kit api), jamais dans l'application ---
# Coolify : URL de l'instance et jeton API (droits : lecture + déploiement)
COOLIFY_BASE_URL=https://coolify.example.com
COOLIFY_ACCESS_TOKEN=changeme
# Cloudflare : jeton limité à la zone fs0ciety.org (Zone Read, DNS Edit)
CLOUDFLARE_API_TOKEN=changeme
